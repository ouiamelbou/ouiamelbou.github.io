        <div class="coin" style="left: 25%; animation-delay: 2s;">💎</div>
        <div class="coin" style="left: 50%; animation-delay: 4s;">🪙</div>
        <div class="coin" style="left: 75%; animation-delay: 6s;">💎</div>
        <div class="coin" style="left: 90%; animation-delay: 1s;">🪙</div>
    </div>

    <div class="loading-overlay" id="loadingOverlay">
        <div class="loading-spinner"></div>
