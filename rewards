    </main>
    
    <footer class="footer">
        <div class="container">
            <p>&copy; 2024 GameVault Pro. All rights reserved. | <a href="#" style="color: #ff6b35;">Privacy Policy</a> | <a href="#" style="color: #ff6b35;">Terms of Service</a></p>
        </div>
    </footer>

    <script>
        // Countdown Timer
        function updateTimer() {
            const now = new Date().getTime();
            const tomorrow = new Date();
            tomorrow.setDate(tomorrow.getDate() + 1);
            tomorrow.setHours(0, 0, 0, 0);
            const distance = tomorrow - now;
            
            const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((distance % (1000 * 60)) / 1000);
            
            document.getElementById('hours').innerHTML = hours.toString().padStart(2, '0');
            document.getElementById('minutes').innerHTML = minutes.toString().padStart(2, '0');
            document.getElementById('seconds').innerHTML = seconds.toString().padStart(2, '0');
        }
        
        setInterval(updateTimer, 1000);
        updateTimer();
        
        // Unlock Content Function
        function unlockContent() {
            const button = document.querySelector('.unlock-button');
            const loadingOverlay = document.getElementById('loadingOverlay');
            
            // Show loading
            loadingOverlay.style.display = 'flex';
            
            // Simulate processing
            setTimeout(() => {
                loadingOverlay.style.display = 'none';
                
                // In a real implementation, this would redirect to CPA offer
                alert('🎉 Redirecting to unlock your rewards! Complete the quick offer to get your gaming package.');
                
                // Example redirect (replace with actual CPA offer URL)
                // window.location.href = 'https://your-cpa-offer-url.com';
            }, 1500);
        }
        
        // Add some interactive effects
        document.addEventListener('mousemove', function(e) {
            const coins = document.querySelectorAll('.coin');
            const mouseX = e.clientX / window.innerWidth;
            const mouseY = e.clientY / window.innerHeight;
            
            coins.forEach((coin, index) => {
                const speed = (index + 1) * 0.5;
                coin.style.transform += ` translate(${mouseX * speed}px, ${mouseY * speed}px)`;
            });
        });
        
        // Scroll animations
        function animateOnScroll() {
            const elements = document.querySelectorAll('.reward-item, .trust-badge');
            
            elements.forEach(element => {
                const rect = element.getBoundingClientRect();
                const isVisible = rect.top < window.innerHeight && rect.bottom > 0;
                
                if (isVisible) {
                    element.style.transform = 'translateY(0)';
                    element.style.opacity = '1';
                } else {
                    element.style.transform = 'translateY(20px)';
                    element.style.opacity = '0.7';
                }
            });
        }
        
        window.addEventListener('scroll', animateOnScroll);
        animateOnScroll();
        
        // Button click tracking (for analytics)
        document.querySelector('.unlock-button').addEventListener('click', function() {
            // Track conversion event
            console.log('Unlock button clicked - CPA conversion initiated');
            
            // You can add analytics tracking here
            // gtag('event', 'cpa_click', { 'event_category': 'gaming' });
        });
        
        // Page load optimization
        window.addEventListener('load', function() {
            // Hide any loading states
            document.body.classList.add('loaded');
            
            // Start floating coin animations with random delays
            const coins = document.querySelectorAll('.coin');
            coins.forEach((coin, index) => {
                coin.style.animationDelay = Math.random() * 8 + 's';
            });
        });
    </script>
</body>
